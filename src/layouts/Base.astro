---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { site } from '../data/site';
import { cleanPath } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** JSON-LD objekty pro strukturovaná data */
  schema?: Record<string, unknown>[];
  /** Admin stránky nemají veřejnou hlavičku/patičku */
  bare?: boolean;
}

const { title, description = site.description, image = site.heroImage, noindex = false, schema = [], bare = false } = Astro.props;

const canonical = new URL(cleanPath(Astro.url.pathname), site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  email: site.email,
  telephone: '+420603538440',
  areaServed: { '@type': 'Country', name: 'Česká republika' },
};
const allSchema = bare ? [] : [orgSchema, ...schema];
---

<!doctype html>
<html lang="cs" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="preconnect" href="https://i.postimg.cc" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a href="#obsah" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] btn-primary">
            Přeskočit na obsah
          </a>
          <Header />
          <main id="obsah">
            <slot />
          </main>
          <Footer />
          <FloatingContact />
        </>
      )
    }

    <script>
      // Scroll-reveal: prvky s třídou .reveal se jemně „vynoří“ při scrollu
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
