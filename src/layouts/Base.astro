---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import SuccessModal from '../components/SuccessModal.astro';
import { site } from '../data/site';
import { cleanPath } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  /** Sdílecí obrázek (cesta od kořene nebo absolutní URL), výchozí /og.png 1200×630 */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** JSON-LD objekty pro strukturovaná data */
  schema?: Record<string, unknown>[];
  /** Drobečková navigace pro BreadcrumbList (bez úvodní stránky) */
  breadcrumbs?: { name: string; path: string }[];
  /** Admin stránky nemají veřejnou hlavičku/patičku */
  bare?: boolean;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  noindex = false,
  schema = [],
  breadcrumbs = [],
  bare = false,
} = Astro.props;

const canonical = new URL(cleanPath(Astro.url.pathname), site.url).href;
const imageUrl = new URL(image, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: 'Retrovýkup',
  url: `${site.url}/`,
  logo: { '@type': 'ImageObject', url: `${site.url}/icon-512.png`, width: 512, height: 512 },
  image: `${site.url}/og.png`,
  description: site.description,
  email: site.email,
  telephone: site.phoneIntl,
  areaServed: { '@type': 'Country', name: 'Česká republika' },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phoneIntl,
    email: site.email,
    contactType: 'customer service',
    areaServed: 'CZ',
    availableLanguage: ['cs'],
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: `${site.url}/`,
  inLanguage: 'cs-CZ',
  publisher: { '@id': `${site.url}/#organization` },
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Retrovykup', path: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.path, site.url).href,
      })),
    }
  : null;
const allSchema = bare || noindex ? [] : [orgSchema, websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang="cs" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Ikony a PWA -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph / sdílení -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="sitemap" href="/sitemap.xml" />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a href="#obsah" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] btn-primary">
            Přeskočit na obsah
          </a>
          <Header />
          <main id="obsah">
            <slot />
          </main>
          <Footer />
          <FloatingContact />
          <SuccessModal />
        </>
      )
    }

    <script>
      // Scroll-reveal: prvky s třídou .reveal se jemně „vynoří“ při scrollu
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
