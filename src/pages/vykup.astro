---
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/site';
---

<Base
  title="Jak probíhá výkup starožitností | 4 jednoduché kroky | Retrovykup"
  description="Jak probíhá výkup starožitností u Retrovykup: pošlete fotky, do 24 h dostanete férovou nabídku, přijedeme pro věci a zaplatíme hotově nebo převodem.">
  <section class="pt-14 pb-6 sm:pt-20">
    <div class="container-x">
      <span class="pill rise"><Icon name="sparkles" class="size-3.5" /> Jednoduše a bez starostí</span>
      <h1 class="h-display mt-6 max-w-4xl text-[clamp(3rem,8vw,6.5rem)]">
        <span class="rise block" style="--d:100ms">Jak probíhá</span>
        <span class="rise block" style="--d:220ms"><em>výkup předmětů</em></span>
      </h1>
      <p class="rise mt-6 max-w-2xl text-lg text-muted" style="--d:350ms">
        Od první fotky až po platbu. Celý proces je nezávazný — dokud nabídku nepřijmete, k ničemu se nezavazujete.
      </p>
      <div class="rise mt-8" style="--d:450ms">
        <a href="/#formular" class="btn-primary px-7 py-4 text-base">
          Výkupní formulář
          <Icon name="arrow-right" class="arrow size-5" />
        </a>
      </div>
    </div>
  </section>

  <Sections show="steps" title="Od fotky k penězům" />
  <Sections show="benefits" />
  <Sections show="categories" />

  <section class="py-10">
    <div class="container-x">
      <div class="grain reveal flex flex-col items-start gap-6 rounded-[2.5rem] bg-ink p-10 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-14">
        <div>
          <h2 class="h-display text-4xl sm:text-5xl">Připraveni prodat?</h2>
          <p class="mt-3 text-white/60">Začněte dnes — ocenění je zdarma a nezávazné.</p>
        </div>
        <a href="/#formular" class="btn-light shrink-0 px-7 py-4 text-base">
          Chci nabídku
          <Icon name="arrow-right" class="arrow size-5" />
        </a>
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>
