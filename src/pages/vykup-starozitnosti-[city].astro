---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import SellForm from '../components/SellForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { cities, cityUrl, type City } from '../data/cities';
import { faq as baseFaq, site } from '../data/site';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const url = `${site.url}${cityUrl(city)}`;

// SEO: title do ~60 znaků, description 120–160 znaků
const longTitle = `Výkup starožitností ${city.name} – nabídka do 24 h | Retrovykup`;
const seoTitle = longTitle.length <= 62 ? longTitle : `Výkup starožitností ${city.name} | Retrovykup`;
const longDesc = `Výkup starožitností ${city.locative} a okolí. Pošlete fotky a do 24 h máte nabídku. Nábytek, obrazy, porcelán, lustry, militaria. Platba ihned, odvoz zdarma.`;
const seoDesc = longDesc.length <= 160 ? longDesc : longDesc.replace(', militaria', '').replace(', odvoz zdarma', '');

const faq = [
  ...city.faq,
  { q: `Jak rychle dostanu nabídku ${city.locative}?`, a: `Ocenění z fotek posíláme do 24 hodin. Termín vyzvednutí ${city.locative} domluvíme podle vašich možností.` },
  ...baseFaq.filter((f) => /platba|fotkami/i.test(f.q)),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Výkup starožitností ${city.name}`,
    serviceType: 'Výkup starožitností a retro předmětů',
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: [
      { '@type': 'City', name: city.name, geo: { '@type': 'GeoCoordinates', latitude: city.lat, longitude: city.lon } },
      ...city.surroundings.map((s) => ({ '@type': 'Place', name: s })),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title={seoTitle}
  description={seoDesc}
  imageAlt={`Výkup starožitností ${city.name} — Retrovykup`}
  breadcrumbs={[
    { name: 'Výkup po celé ČR', path: '/vykup-starozitnosti' },
    { name: city.name, path: cityUrl(city) },
  ]}
  schema={schema}>
  <Hero
    eyebrow={`Výkup po celé ČR · ${city.name} a okolí`}
    lines={['Výkup', 'starožitností', `_${city.name}_`]}
    text={city.intro}
  />

  <nav class="container-x pt-5 text-xs text-muted" aria-label="Drobečková navigace">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-ink">Úvod</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/vykup-starozitnosti" class="hover:text-ink">Výkup po celé ČR</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-ink" aria-current="page">{city.name}</li>
    </ol>
  </nav>


  <Sections show="marquee" />

  <!-- Lokální obsah -->
  <section class="py-20">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow reveal">Výkup {city.locative}</p>
        <h2 class="h-display reveal mt-3 text-4xl sm:text-5xl" style="--d:80ms">{city.local.title}</h2>
        <p class="reveal mt-6 text-lg leading-relaxed text-muted" style="--d:140ms">{city.local.text}</p>
        <div class="reveal mt-8 flex flex-wrap gap-2" style="--d:200ms">
          {
            city.highlights.map((h) => (
              <span class="pill border-ink bg-ink px-4 py-2 text-sm text-paper">
                <Icon name="sparkles" class="size-3.5" />
                {h}
              </span>
            ))
          }
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card reveal" style="--d:100ms">
          <span class="icon-bubble"><Icon name="map-pin" class="size-5" /></span>
          <h3 class="mt-5 font-semibold">Části města</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {city.districts.map((d) => <li class="rounded-full bg-mist px-3 py-1 text-xs">{d}</li>)}
          </ul>
        </div>
        <div class="card reveal" style="--d:180ms">
          <span class="icon-bubble"><Icon name="compass" class="size-5" /></span>
          <h3 class="mt-5 font-semibold">Okolí {city.genitive.replace(/^ze? /, '')}</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {city.surroundings.map((s) => <li class="rounded-full bg-mist px-3 py-1 text-xs">{s}</li>)}
          </ul>
        </div>
        <div class="card reveal grain bg-ink text-paper sm:col-span-2" style="--d:240ms">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-lg font-semibold">Máte věci k prodeji {city.locative}?</p>
              <p class="mt-1 text-sm text-white/60">Zavolejte, nebo pošlete fotky přes formulář níže.</p>
            </div>
            <a href={site.phoneHref} class="btn-light shrink-0">
              <Icon name="phone" class="size-4" />
              {site.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SellForm defaultLocation={city.name} heading={`Výkup starožitností ${city.name}`} />
  <Sections show="categories" title={`Co vykupujeme ${city.locative}`} />
  <CtaBand title={`Prodáváte ${city.locative}?`} text={`Pošlete fotky a do 24 hodin máte nabídku. Pro věci si přijedeme ${city.locative} i do okolí.`} />
  <Sections show="steps" />
  <Faq items={faq} title={`Výkup ${city.locative} — otázky`} />
  <Sections show="cities" exclude={city.slug} title="Vykupujeme i v dalších městech" />
  <CtaBand title="Získejte nabídku ještě dnes" variant="light" />
</Base>
