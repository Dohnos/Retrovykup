---
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';
import Icon from '../components/Icon.astro';
import { cities, cityUrl } from '../data/cities';
import { site } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Výkup starožitností ve městech',
    itemListElement: cities.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Výkup starožitností ${c.name}`,
      url: `${site.url}${cityUrl(c)}`,
    })),
  },
];
---

<Base
  title="Výkup starožitností ve vašem městě | Praha, Brno, Ostrava, Plzeň, Liberec, Olomouc | Retrovykup"
  description="Výkup starožitností v Praze, Brně, Ostravě, Plzni, Liberci, Olomouci a po celé ČR. Ocenění z fotek do 24 hodin, vyzvednutí u vás a platba ihned."
  schema={schema}>
  <section class="pt-14 pb-6 sm:pt-20">
    <div class="container-x">
      <span class="pill rise"><Icon name="map-pin" class="size-3.5" /> Po celé České republice</span>
      <h1 class="h-display mt-6 max-w-4xl text-[clamp(3rem,8vw,6.5rem)]">
        <span class="rise block" style="--d:100ms">Výkup starožitností</span>
        <span class="rise block" style="--d:220ms"><em>ve vašem městě</em></span>
      </h1>
      <p class="rise mt-6 max-w-2xl text-lg text-muted" style="--d:350ms">
        Vykupujeme po celé ČR — nejčastěji jezdíme do největších měst a jejich okolí. Vyberte své město, nebo rovnou pošlete
        fotky přes formulář.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-x grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cities.map((c, i) => (
          <a
            href={cityUrl(c)}
            class="group reveal card card-hover relative flex min-h-64 flex-col justify-between overflow-hidden p-7 hover:bg-ink hover:text-paper"
            style={`--d:${(i % 3) * 80}ms`}>
            <div class="flex items-start justify-between">
              <span class="text-xs font-medium text-muted transition-colors group-hover:text-white/60">{c.region}</span>
              <span class="grid size-11 place-items-center rounded-full bg-mist text-ink transition-transform duration-500 ease-(--ease-spring) group-hover:rotate-45">
                <Icon name="arrow-up-right" class="size-5" />
              </span>
            </div>
            <div>
              <p class="text-sm text-muted transition-colors group-hover:text-white/60">Výkup starožitností</p>
              <h2 class="h-display text-5xl">{c.name}</h2>
              <p class="mt-3 line-clamp-2 text-sm text-muted transition-colors group-hover:text-white/70">
                {c.surroundings.slice(0, 4).join(' · ')}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <Sections show="steps" />

  <section class="py-10">
    <div class="container-x">
      <div class="grain reveal flex flex-col items-start gap-6 rounded-[2.5rem] bg-ink p-10 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-14">
        <div>
          <h2 class="h-display text-4xl sm:text-5xl">Vaše město tu není?</h2>
          <p class="mt-3 text-white/60">Nevadí. Vykupujeme po celé republice — stačí poslat fotky.</p>
        </div>
        <a href="/#formular" class="btn-light shrink-0 px-7 py-4 text-base">
          Poslat fotky
          <Icon name="arrow-right" class="arrow size-5" />
        </a>
      </div>
    </div>
  </section>
</Base>
