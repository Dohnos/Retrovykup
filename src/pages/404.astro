---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Stránka nenalezena | Retrovykup" noindex>
  <section class="grid min-h-[60vh] place-items-center py-20 text-center">
    <div class="container-x">
      <p class="h-display rise text-[clamp(6rem,20vw,12rem)] italic">404</p>
      <p class="rise mt-2 text-lg text-muted" style="--d:120ms">Tahle stránka se asi ztratila na půdě.</p>
      <a href="/" class="btn-primary rise mt-8" style="--d:240ms">
        Zpět na úvod
        <Icon name="arrow-right" class="arrow size-4" />
      </a>
    </div>
  </section>
</Base>
