---
/**
 * Puncovní značky — oficiální přehled (obrázek) + textová tabulka pro SEO a čtečky.
 * Podle vyhlášky č. 363/2003 Sb.
 */
import Icon from './Icon.astro';

interface Props {
  metal: 'zlato' | 'stribro';
}
const { metal } = Astro.props;

const data = { title: 'Jak přečíst punc', em: metal === 'zlato' ? 'na zlatě' : 'na stříbře' };
---

<section id="puncovni-znacky" class="scroll-mt-36 py-20">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <p class="eyebrow reveal">Puncovní značky</p>
        <h2 class="h-display reveal mt-3 text-4xl sm:text-5xl" style="--d:80ms">{data.title} <em>{data.em}</em></h2>
      </div>
      <p class="reveal text-lg leading-relaxed text-muted lg:pb-1" style="--d:140ms">
        Punc je malá značka, kterou Puncovní úřad potvrzuje ryzost drahého kovu. Číslice ve značce není obsah kovu, ale pořadové číslo
        ryzosti — čím nižší, tím ryzejší kov.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      <!-- Oficiální přehled značek -->
      <figure class="reveal">
        <a
          href="/images/ceske-puncovni-znacky.jpg"
          target="_blank"
          class="group relative block overflow-hidden rounded-[2rem] border border-line bg-ink"
          aria-label="Otevřít přehled puncovních značek ve velkém rozlišení">
          <picture>
            <source srcset="/images/ceske-puncovni-znacky.webp" type="image/webp" />
            <img
              src="/images/ceske-puncovni-znacky.jpg"
              width="876"
              height="1134"
              loading="lazy"
              decoding="async"
              alt="České puncovní značky pro zlaté, stříbrné a platinové zboží: státní značky zlata (999 až 585: hlava orla, kohouta a labutě), stříbra (999 až 800: hlava kamzíka a zajíce) a platiny (999 až 800: koruna), značky Konvence s vahami, značky pro staré zboží nižší ryzosti a znaménka METAL, MET a M."
              class="h-auto w-full transition-transform duration-700 ease-(--ease-spring) group-hover:scale-[1.02]"
            />
          </picture>
          <span class="absolute right-4 bottom-4 inline-flex items-center gap-1.5 rounded-full bg-paper px-3 py-1.5 text-xs font-semibold text-ink shadow-lg">
            <Icon name="zoom-in" class="size-3.5" /> Zvětšit
          </span>
        </a>
        <figcaption class="mt-3 text-xs text-muted">
          České puncovní značky pro zlaté, stříbrné a platinové zboží. Zdroj: Puncovní úřad.
        </figcaption>
      </figure>

    </div>

    <!-- Puncovní úřad -->
    <div class="grain reveal mt-10 flex flex-col gap-6 rounded-[2rem] bg-ink p-7 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-9">
      <div class="flex items-start gap-4">
        <span class="icon-bubble bg-paper text-ink"><Icon name="landmark" class="size-5" /></span>
        <div>
          <p class="text-lg font-semibold">Puncovní úřad</p>
          <p class="mt-1 max-w-xl text-sm text-white/60">
            Státní úřad, který značí a zkouší zboží z drahých kovů. Najdete u něj přehled všech platných i starších uznávaných
            puncovních značek a můžete si nechat ověřit ryzost. Kozí 4, 110 00 Praha 1.
          </p>
        </div>
      </div>
      <a href="https://punc.gov.cz" target="_blank" rel="noopener noreferrer" class="btn-light shrink-0 px-6 py-3.5 whitespace-nowrap">
        punc.gov.cz
        <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>
  </div>
</section>
