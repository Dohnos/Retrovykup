---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<a href="/" class="group inline-flex items-center gap-2.5" aria-label="Retrovykup — úvodní stránka">
  <span
    class:list={[
      'grid size-9 place-items-center rounded-full font-display text-xl italic transition-transform duration-500 ease-(--ease-spring) group-hover:rotate-[-12deg]',
      dark ? 'bg-paper text-ink' : 'bg-ink text-paper',
    ]}>R</span
  >
  <span class="text-sm font-semibold tracking-[0.14em] uppercase sm:text-[15px] sm:tracking-[0.18em]">Retrovykup</span>
</a>
