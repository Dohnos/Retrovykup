---
import BrandMark from './BrandMark.astro';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<a href="/" class="group inline-flex items-center gap-2.5" aria-label="Retrovykup — výkup starožitností, úvodní stránka">
  <span class="transition-transform duration-700 ease-(--ease-spring) group-hover:rotate-[-14deg]">
    <BrandMark class="size-10" invert={dark} />
  </span>
  <span class="flex flex-col leading-none">
    <span class="flex items-baseline">
      <span class="text-[15px] font-semibold tracking-[0.16em] uppercase">Retro</span><span
        class="font-display text-[1.45rem] leading-none italic">vykup</span
      >
    </span>
    <span class:list={['mt-0.5 text-[10px] font-medium tracking-[0.14em] uppercase', dark ? 'text-white/50' : 'text-muted']}>
      Výkup starožitností
    </span>
  </span>
</a>
