---
/**
 * Sdílené sekce. Použití: <Sections show="categories" /> atd.
 */
import Icon from './Icon.astro';
import { categories, steps, benefits } from '../data/site';
import { cities, cityUrl } from '../data/cities';

interface Props {
  show: 'categories' | 'steps' | 'benefits' | 'cities' | 'marquee';
  title?: string;
  exclude?: string;
}
const { show, title, exclude } = Astro.props;
const marqueeItems = ['Nábytek', 'Obrazy', 'Porcelán', 'Sklo', 'Lustry', 'Hodiny', 'Hračky', 'Militaria', 'Retro design', 'Pozůstalosti'];
---

{
  show === 'marquee' && (
    <div class="overflow-hidden border-y border-line py-5" aria-hidden="true">
      <div class="animate-marquee flex w-max gap-10 whitespace-nowrap">
        {[...marqueeItems, ...marqueeItems].map((t) => (
          <span class="flex items-center gap-10 text-2xl font-semibold tracking-tight sm:text-3xl">
            {t}
            <span class="size-2 rounded-full bg-ink" />
          </span>
        ))}
      </div>
    </div>
  )
}

{
  show === 'benefits' && (
    <section class="py-20">
      <div class="container-x grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((b, i) => (
          <div class="card card-hover group reveal" style={`--d:${i * 80}ms`}>
            <span class="icon-bubble">
              <Icon name={b.icon} class="size-5" />
            </span>
            <h3 class="mt-5 text-lg font-semibold">{b.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{b.text}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

{
  show === 'categories' && (
    <section id="co-vykupujeme" class="scroll-mt-36 py-20">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="eyebrow reveal">Co vykupujeme</p>
            <h2 class="h-display reveal mt-3 max-w-2xl text-4xl sm:text-5xl" style="--d:80ms">
              {title ?? (
                <>
                  Starožitnosti a retro <em>do roku 1989</em>
                </>
              )}
            </h2>
          </div>
          <a href="/#formular" class="btn-ghost reveal self-start md:self-auto" style="--d:160ms">
            Nevíte? Pošlete fotku
            <Icon name="arrow-right" class="arrow size-4" />
          </a>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {categories.map((c, i) => (
            <div class="card card-hover group reveal flex flex-col" style={`--d:${(i % 4) * 70}ms`}>
              <div class="flex items-center justify-between">
                <span class="icon-bubble">
                  <Icon name={c.icon} class="size-5" />
                </span>
                <span class="text-xs font-medium text-muted tabular-nums">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-lg font-semibold">{c.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  show === 'steps' && (
    <section class="py-20">
      <div class="container-x">
        <p class="eyebrow reveal">Jak to funguje</p>
        <h2 class="h-display reveal mt-3 max-w-2xl text-4xl sm:text-5xl" style="--d:80ms">
          {title ?? (
            <>
              Čtyři kroky. <em>Žádné starosti.</em>
            </>
          )}
        </h2>
        <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {steps.map((s, i) => (
            <li class="card card-hover group reveal relative overflow-hidden" style={`--d:${i * 90}ms`}>
              <span class="pointer-events-none absolute -top-3 right-1 text-[6rem] leading-none font-bold tracking-tighter text-ink/[0.06] transition-transform duration-700 ease-(--ease-spring) group-hover:-translate-y-2">
                {i + 1}
              </span>
              <span class="icon-bubble">
                <Icon name={s.icon} class="size-5" />
              </span>
              <h3 class="mt-6 text-lg font-semibold">{s.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  show === 'cities' && (
    <section class="py-20">
      <div class="container-x">
        <p class="eyebrow reveal">Výkup ve vašem městě</p>
        <h2 class="h-display reveal mt-3 max-w-2xl text-4xl sm:text-5xl" style="--d:80ms">
          {title ?? (
            <>
              Přijedeme <em>kamkoliv</em> v ČR
            </>
          )}
        </h2>
        <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {cities
            .filter((c) => c.slug !== exclude)
            .map((c, i) => (
              <a
                href={cityUrl(c)}
                class="group reveal flex items-center justify-between gap-4 rounded-full border border-line bg-paper py-2.5 pr-2.5 pl-6 transition-all duration-500 ease-(--ease-spring) hover:border-ink hover:bg-ink hover:text-paper"
                style={`--d:${(i % 3) * 70}ms`}>
                <span>
                  <span class="block text-xs text-muted transition-colors group-hover:text-white/60">Výkup starožitností</span>
                  <span class="block text-lg font-semibold">{c.name}</span>
                </span>
                <span class="grid size-11 place-items-center rounded-full bg-mist text-ink transition-transform duration-500 ease-(--ease-spring) group-hover:rotate-45 group-hover:bg-paper">
                  <Icon name="arrow-up-right" class="size-5" />
                </span>
              </a>
            ))}
        </div>
      </div>
    </section>
  )
}
