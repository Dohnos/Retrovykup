---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  /** Řádky nadpisu — každý se animuje zvlášť. Text v _podtržítkách_ bude kurzívou. */
  lines: string[];
  text: string;
  image?: string;
  imageAlt?: string;
}
const { eyebrow, lines, text, image = site.heroImage, imageAlt = 'Starožitnosti' } = Astro.props;

const fmt = (s: string) => s.replace(/_(.+?)_/g, '<em>$1</em>');
---

<section class="px-2 pt-2 sm:px-3">
  <div class="grain relative overflow-hidden rounded-[2rem] bg-ink text-paper sm:rounded-[2.5rem]">
    <!-- Pozadí: černobílá fotka + přechod -->
    <img
      src={image}
      alt={imageAlt}
      width="1600"
      height="1000"
      fetchpriority="high"
      decoding="async"
      class="hero-img absolute inset-0 -z-10 size-full object-cover opacity-45 grayscale"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/85 to-ink/40"></div>

    <div class="container-x grid items-center gap-8 py-8 sm:py-12 lg:min-h-[min(78svh,720px)] lg:grid-cols-[1.15fr_0.85fr] lg:gap-12 lg:py-14">
      <!-- Text + CTA -->
      <div>
        <span class="rise inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-medium backdrop-blur">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-paper opacity-70"></span>
            <span class="relative inline-flex size-2 rounded-full bg-paper"></span>
          </span>
          {eyebrow}
        </span>

        <h1 class="h-display mt-5 text-[clamp(2.75rem,8vw,6.25rem)]">
          {lines.map((l, i) => <span class="rise block" style={`--d:${80 + i * 100}ms`} set:html={fmt(l)} />)}
        </h1>

        <p class="rise mt-5 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg" style="--d:380ms">{text}</p>

        <div class="rise mt-7 flex flex-col gap-3 sm:flex-row" style="--d:460ms">
          <a href="#formular" data-cta class="btn-light group px-7 py-4 text-base shadow-[0_10px_40px_-10px_rgba(255,255,255,0.5)]">
            <Icon name="camera" class="size-5" />
            Získat nabídku zdarma
            <Icon name="arrow-right" class="arrow size-5" />
          </a>
          <a href={site.phoneHref} class="btn-ghost-dark px-7 py-4 text-base">
            <Icon name="phone" class="size-5" />
            {site.phone}
          </a>
        </div>

        <ul class="rise mt-7 flex flex-wrap gap-2 text-xs sm:text-sm" style="--d:560ms">
          {
            [
              ['clock', 'Nabídka do 24 h'],
              ['banknote', 'Platba ihned'],
              ['truck', 'Odvoz zdarma'],
              ['badge-check', 'Nezávazně'],
            ].map(([icon, t]) => (
              <li class="flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5">
                <Icon name={icon} class="size-3.5" /> {t}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Rychlá nabídka -->
      <div class="rise" style="--d:300ms">
        <form id="quick-offer" class="rounded-[1.75rem] bg-paper p-5 text-ink shadow-2xl sm:p-7" novalidate>
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-lg font-semibold">Rychlá nabídka</p>
              <p class="text-sm text-muted">Fotka + telefon = cena do 24 h</p>
            </div>
            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-ink text-center text-paper">
              <span class="font-display text-2xl leading-none italic">24h</span>
            </span>
          </div>

          <label
            for="q-photos"
            class="group mt-5 flex cursor-pointer items-center gap-4 rounded-3xl border-2 border-dashed border-line bg-mist p-4 transition-all duration-300 hover:border-ink hover:bg-paper">
            <span class="icon-bubble"><Icon name="image-plus" class="size-5" /></span>
            <span class="min-w-0">
              <span id="q-photos-label" class="block font-semibold">Nahrát / vyfotit předměty</span>
              <span class="block text-xs text-muted">Stačí pár fotek z mobilu</span>
            </span>
            <input id="q-photos" type="file" accept="image/*" multiple class="sr-only" />
          </label>

          <div class="relative mt-3">
            <Icon name="phone" class="pointer-events-none absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted" />
            <input
              id="q-phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel-national"
              placeholder="Váš telefon"
              aria-label="Váš telefon"
              class="field pl-10"
            />
          </div>

          <button type="submit" class="btn-primary mt-3 w-full py-4 text-base">
            Pokračovat k nabídce
            <Icon name="arrow-right" class="arrow size-5" />
          </button>

          <p class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-muted">
            <Icon name="shield-check" class="size-3.5" /> Zdarma · nezávazně · údaje chráníme dle GDPR
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-img {
    animation: heroZoom 18s ease-out both;
  }
  @keyframes heroZoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
</style>

<script>
  const quick = document.getElementById('quick-offer') as HTMLFormElement | null;
  if (quick) {
    const photos = document.getElementById('q-photos') as HTMLInputElement;
    const phone = document.getElementById('q-phone') as HTMLInputElement;
    const label = document.getElementById('q-photos-label')!;
    let picked: File[] = [];

    photos.addEventListener('change', () => {
      picked = Array.from(photos.files ?? []);
      label.textContent = picked.length ? `✓ Vybráno fotek: ${picked.length}` : 'Nahrát / vyfotit předměty';
    });
    phone.addEventListener('input', () => {
      const d = phone.value.replace(/\D/g, '').replace(/^420/, '').slice(0, 9);
      phone.value = d.replace(/(\d{3})(?=\d)/g, '$1 ').trim();
    });
    quick.addEventListener('submit', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('rv:prefill', { detail: { phone: phone.value, files: picked } }));
      picked = [];
      photos.value = '';
      label.textContent = 'Nahrát / vyfotit předměty';
    });
  }
</script>
