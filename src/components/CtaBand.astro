---
import ContactButtons from './ContactButtons.astro';

interface Props {
  title?: string;
  text?: string;
  variant?: 'dark' | 'light';
}
const {
  title = 'Máte doma starožitnosti?',
  text = 'Pošlete fotky a do 24 hodin víte, kolik za ně dostanete. Zdarma a nezávazně.',
  variant = 'dark',
} = Astro.props;
const dark = variant === 'dark';
---

<section class="py-8">
  <div class="container-x">
    <div
      class:list={[
        'reveal relative flex flex-col items-start gap-7 overflow-hidden rounded-[2.5rem] p-8 sm:p-12',
        dark ? 'grain bg-ink text-paper' : 'border border-line bg-mist',
      ]}>
      <div class="relative">
        <h2 class="h-display text-3xl sm:text-4xl">{title}</h2>
        <p class:list={['mt-3 max-w-xl', dark ? 'text-white/60' : 'text-muted']}>{text}</p>
      </div>
      <ContactButtons class="relative" tone={dark ? 'dark' : 'light'} />
      <!-- dekorativní kruhy -->
      <span
        class:list={['pointer-events-none absolute -top-24 -right-24 size-72 rounded-full border', dark ? 'border-white/10' : 'border-ink/10']}
        aria-hidden="true"></span>
      <span
        class:list={['pointer-events-none absolute -top-12 -right-12 size-48 rounded-full border', dark ? 'border-white/10' : 'border-ink/10']}
        aria-hidden="true"></span>
    </div>
  </div>
</section>
