---
/**
 * Inline SVG ikona z knihovny Lucide — vykreslí se při buildu, v prohlížeči 0 kB JS.
 * Použití: <Icon name="phone" class="size-5" />
 */
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
  label?: string;
}

const { name, class: className = 'size-5', strokeWidth = 1.75, label } = Astro.props;

const require = createRequire(import.meta.url);
const iconsDir = require.resolve('lucide-static/package.json').replace(/package\.json$/, 'icons/');

let svg = '';
try {
  svg = readFileSync(`${iconsDir}${name}.svg`, 'utf8');
} catch {
  throw new Error(`Ikona "${name}" v lucide-static neexistuje.`);
}

const inner = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={inner}
/>
