---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="fixed right-4 bottom-4 z-40 flex flex-col gap-2 sm:right-6 sm:bottom-6">
  <a
    href={site.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="group grid size-14 place-items-center rounded-full bg-ink text-paper shadow-[0_12px_30px_-8px_rgba(0,0,0,0.5)] transition-transform duration-300 ease-(--ease-spring) hover:scale-110"
    aria-label="Napsat na WhatsApp">
    <Icon name="message-circle" class="size-6 transition-transform duration-300 group-hover:-rotate-12" />
    <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-ink/30 [animation-duration:2.5s]"></span>
  </a>
</div>
