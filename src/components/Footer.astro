---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ContactButtons from './ContactButtons.astro';
import { site, nav, operator, privacy } from '../data/site';
import { cities, cityUrl } from '../data/cities';
import { services, serviceUrl } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="grain mt-24 rounded-t-[2.5rem] bg-ink text-paper">
  <div class="container-x pt-16 pb-28">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo dark />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          Výkup starožitností a retro předmětů po celé České republice. Férové a rychlé ocenění, platba ihned, diskrétní
          jednání.
        </p>
        <ContactButtons class="mt-6" tone="dark" size="md" />
      </div>

      <div>
        <p class="eyebrow text-white/40">Navigace</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="text-white/70 transition-colors hover:text-white">Úvod</a></li>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="text-white/70 transition-colors hover:text-white">
                  {n.label}
                </a>
              </li>
            ))
          }
          <li><a href="/galerie" class="text-white/70 transition-colors hover:text-white">Galerie</a></li>
          {
            services.map((sv) => (
              <li>
                <a href={serviceUrl(sv)} class="text-white/70 transition-colors hover:text-white">
                  {sv.name}
                </a>
              </li>
            ))
          }
          <li><a href="/#formular" class="text-white/70 transition-colors hover:text-white">Výkupní formulář</a></li>
          <li><a href={privacy.url} class="text-white/70 transition-colors hover:text-white">Ochrana osobních údajů</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow text-white/40">Vykupujeme po celé ČR</p>
        <p class="mt-3 text-xs text-white/40">Přijedeme kamkoliv — například:</p>
        <ul class="mt-3 columns-2 gap-6 text-sm [&>li]:mb-2">
          {
            cities.map((c) => (
              <li>
                <a href={cityUrl(c)} class="text-white/60 transition-colors hover:text-white" title={`Výkup starožitností ${c.name}`}>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Provozovatel -->
    <div class="mt-14 flex flex-col gap-4 rounded-3xl border border-white/10 p-5 text-sm sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white/10"><Icon name="building-2" class="size-4" /></span>
        <div class="text-white/60">
          <p class="eyebrow text-white/40">Provozovatel</p>
          <p class="mt-1">
            <span class="font-semibold text-white">{operator.name || 'Retrovykup'}</span>
            {operator.ico && <span> · IČO {operator.ico}</span>}
            {operator.dic && <span> · DIČ {operator.dic}</span>}
          </p>
          {operator.address && <p>{operator.address}</p>}
          {operator.register && <p class="text-xs text-white/40">{operator.register}</p>}
        </div>
      </div>
      <p class="flex flex-col gap-1 text-white/60 sm:items-end">
        <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
        <a href={site.phoneHref} class="hover:text-white">{site.phone}</a>
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:justify-between">
      <p>© {year} Retrovykup. Všechna práva vyhrazena.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href={privacy.url} class="underline-offset-4 hover:text-white hover:underline">Ochrana osobních údajů (GDPR)</a>
        <span>Web nepoužívá sledovací cookies.</span>
      </p>
    </div>
  </div>
</footer>
