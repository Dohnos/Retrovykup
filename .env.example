# Zkopírujte do .env (lokálně) a stejné proměnné nastavte ve Vercelu.
# Prefix PUBLIC_ = hodnota se vloží do JS v prohlížeči (frontend ji potřebuje).

# 🔥 Firebase (Project settings → General → Your apps → Web app)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# 🖼️ Cloudinary (unsigned upload preset)
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ✉️ EmailJS (admin – odpovědi zákazníkům)
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ZAJEM=
PUBLIC_EMAILJS_TEMPLATE_NEZAJEM=

# 💬 WhatsApp číslo pro souhrny leadů v adminu (jen číslice, např. 420123456789)
PUBLIC_ADMIN_WHATSAPP=
