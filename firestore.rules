// Firestore Security Rules — zkopírujte do Firebase Console → Firestore → Rules → Publish
// ⚠️ Nahraďte VLOZTE_UID_ADMINA za UID svého admin účtu (Firebase Console → Authentication → Users → User UID).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['VLOZTE_UID_ADMINA'];
    }

    match /leads/{leadId} {
      // Veřejný formulář smí jen VYTVÁŘET leady se správnými poli a rozumnou velikostí
      allow create: if request.resource.data.keys().hasOnly([
                         'name','email','phone','location','message','desiredPriceOption','fixedPriceAmount',
                         'photos_count','photos_urls','cloudinary_folder','vykup_id','source','status','timestamp'])
                    && request.resource.data.status == 'nova'
                    && request.resource.data.name is string && request.resource.data.name.size() < 200
                    && request.resource.data.message is string && request.resource.data.message.size() < 5000
                    && request.resource.data.photos_urls is list && request.resource.data.photos_urls.size() <= 20
                    && request.resource.data.timestamp == request.time;

      // Číst, upravovat a mazat smí JEN admin (ne kdokoliv přihlášený!)
      allow read, update, delete: if isAdmin();
    }
  }
}
